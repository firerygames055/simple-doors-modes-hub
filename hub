    closeBtn.Parent = mainFrame

    -- Generate entity script buttons dynamically
    for _, item in ipairs(cmd_map) do
        local name = item[1]
        local url = item[2]

        local entBtn = Instance.new("TextButton")
        entBtn.Name = name .. "Button"
        entBtn.BackgroundColor3 = Color3.fromRGB(35, 30, 30)
        entBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
        entBtn.TextSize = 14
        entBtn.Font = Enum.Font.SourceSans
        entBtn.Text = name
        entBtn.Parent = scrollFrame

        entBtn.MouseButton1Click:Connect(function()
            if auth_list[lp.Name] then
                G_Mod.caption("[Creator / Head admin]: Executing " .. name .. "!")
                s_Load(url)
            else
                G_Mod.caption("Your not an admin!")
            end
        end)
    end

    -- Menu Slide Window Animation Controls
    local isOpen = false
    local t_Info = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    local function toggleMenu()
        if not isOpen then
            isOpen = true
            mainFrame.Visible = true
            TS:Create(mainFrame, t_Info, {Position = pos_Visible}):Play()
        else
            isOpen = false
            local c_Tween = TS:Create(mainFrame, t_Info, {Position = pos_Hidden})
            c_Tween:Play()
            c_Tween.Completed:Connect(function()
                if not isOpen then mainFrame.Visible = false end
            end)
        end
    end

    toggleBtn.MouseButton1Click:Connect(toggleMenu)
    closeBtn.MouseButton1Click:Connect(toggleMenu)

    -- Toggle panel using the F key
    UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
        if gameProcessedEvent then return end -- Ignores keypress if typing in chat
        if input.KeyCode == Enum.KeyCode.F then
            toggleMenu()
        end
    end)
end)

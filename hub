    -- FIX: Defined the missing s_Load handler to execute raw GitHub code
    local function s_Load(url)
        task.spawn(function()
            local success, content = pcall(function()
                return game:HttpGet(url)
            end)
            
            if success and content then
                local execSuccess, execErr = pcall(function()
                    loadstring(content)()
                end)
                if not execSuccess then
                    G_Mod.caption("Execution Failed! View console (F9) for details.")
                    warn("[Hub Error]: " .. tostring(execErr))
                end
            else
                G_Mod.caption("Network Error: Could not download the script.")
                warn("[Hub Error]: Failed to fetch URL -> " .. tostring(url))
            end
        end)
    end
    
    -- Fixed & updated entity script map
    local cmd_map = {
        {"Hardcore mode", "https://raw.githubusercontent.com/thelostw3r/Mods/refs/heads/main/HardcoreMode.lua"},
        {"Hardcore legacy", "https://raw.githubusercontent.com/thelostw3r/Mods/refs/heads/main/HardcoreMode%5BLEGACY%5D.lua"},

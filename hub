        ["imisscrying1"] = true,
        [lp.Name] = true -- FIX: Automatically whitelists YOU so it works instantly!
    }
    
    -- FIX: Created the missing G_Mod caption notifications system
    local G_Mod = {
        caption = function(text)
            print("[Admin Panel]: " .. text)
            

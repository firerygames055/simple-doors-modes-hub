        {"hardcore fix", "https://raw.githubusercontent.com/firerygames055/small-fix-for-doors-hardcore-by-thelost3wr/refs/heads/main/fix"},
        {"floor 2 theme", "https://raw.githubusercontent.com/Junxd-03/Floor-2/refs/heads/main/New"},
        {"HUNGERED", "https://raw.githubusercontent.com/eoyoustme/ohh/b4925f04895ca7d0ce90f9c72a08fb00325b9d6a/HUNGERED"},
        {"nightmare mode", "https://raw.githubusercontent.com/reboundplayz/Doors-Fixed-Modes/refs/heads/main/Nightmare%20Mode"}
    }

    -- Build GUI Layout
    local scr = Instance.new("ScreenGui")
    scr.Name = "FragmentedAdminUI"
    scr.ResetOnSpawn = false
    scr.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    scr.Parent = p_Gui

    -- Admin Toggle Button (Left Side)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Name = "AdminToggleButton"
    toggleBtn.Size = UDim2.new(0, 50, 0, 85)
    toggleBtn.Position = UDim2.new(0, 15, 0.5, -42)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
    toggleBtn.BorderSizePixel = 2
    toggleBtn.BorderColor3 = Color3.fromRGB(150, 50, 50)
    toggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)

-- Persistent Execution Button Wrapper
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TargetStorage = CoreGui or LocalPlayer:WaitForChild("PlayerGui")

-- 1. Create the persistent floating Toggle Button ScreenGui
local ToggleScreen = Instance.new("ScreenGui")
ToggleScreen.Name = "UniversalHubExecutorGui"
ToggleScreen.Parent = TargetStorage
ToggleScreen.ResetOnSpawn = false
ToggleScreen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- 2. Build the visual "HUB" Clickable Button
local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "HUB_Button"
ToggleButton.Parent = ToggleScreen
ToggleButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
ToggleButton.Position = UDim2.new(0, 15, 0, 80) -- Positions it safely in the upper left section
ToggleButton.Size = UDim2.new(0, 85, 0, 35)
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.Text = "HUB"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 14
ToggleButton.BorderSizePixel = 0
ToggleButton.ZIndex = 9999999 -- Keeps it layered over other screen structures

-- Round the button corners nicely
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = ToggleButton

-- Add a glowing border frame around the button
local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(180, 0, 255) -- Matches the script's visual text color theme
UIStroke.Thickness = 2
UIStroke.Parent = ToggleButton

-- 3. Action to perform whenever the HUB button is pressed
ToggleButton.MouseButton1Click:Connect(function()
    -- Look for any active copies of the Kavo framework generated by this hub script
    local ExistingUI = TargetStorage:FindFirstChild("⭐Doors Modes Hub V25⭐ (Alpha)")
    
    if ExistingUI then
        -- If it exists already, delete the old container instance to prevent duplicates or UI stacking
        ExistingUI:Destroy()
    end
    
    -- Execute a fresh request to the main script URL safely inside a protected thread pool
    task.spawn(function()
        local success, err = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/idkman60093/Doors-Modes-Hub/refs/heads/main/Doors-Modes-Hub-V25-(Alpha)"))()
        end)
        if not success then
            warn("Execution Error detected inside underlying framework: ", err)
        end
    end)
end)
